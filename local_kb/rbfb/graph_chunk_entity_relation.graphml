  <data key="d2">chunk-261e2b461646c649ae18e976ba31858f</data>
</node>
<node id="服务器">
  <data key="d0">category</data>
  <data key="d1">A central system that collects and aggregates updates from clients in federated learning.&lt;SEP&gt;The server refers to the entity that receives updates from clients and aggregates them to update the global model.</data>
  <data key="d2">chunk-261e2b461646c649ae18e976ba31858f&lt;SEP&gt;chunk-81cb9bc58fbb6b43753e03e568548331</data>
</node>
<node id="客户端">
  <data key="d0">category</data>
  <data key="d1">An individual entity or device that contributes its local model updates to the global model in federated learning.&lt;SEP&gt;The client refers to the entity that performs local updates and communicates with the server in distributed optimization.</data>
  <data key="d2">chunk-261e2b461646c649ae18e976ba31858f&lt;SEP&gt;chunk-81cb9bc58fbb6b43753e03e568548331</data>
</node>
<node id="数据采样">
