  <data key="d5">9</data>
  <data key="d6">chunk-47d799488921d39a7d144085504292d8</data>
</edge>
<edge source="谱半径" target="收敛速度">
  <data key="d3">6.0</data>
  <data key="d4">The spectral radius is a measure that determines the convergence speed of iterative methods. A smaller spectral radius indicates a faster convergence speed."|&gt;"measurement, convergence speed</data>
  <data key="d5">6</data>
